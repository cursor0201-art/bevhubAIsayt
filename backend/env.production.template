# Backend Production Environment Variables

# Security
DJANGO_SECRET_KEY=django-insecure-prod-key-generate-a-new-one
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.bevhub.ai,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://bevhub.ai,http://localhost:3000

# Database (PostgreSQL via Docker)
POSTGRES_DB=bevhub_prod
POSTGRES_USER=bevhub_admin
POSTGRES_PASSWORD=super_secure_password_123
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Integrations
STRIPE_WEBHOOK_SECRET=whsec_your_production_secret
OPENAI_API_KEY=your_openai_production_key
