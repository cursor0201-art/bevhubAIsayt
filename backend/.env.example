# =============================================================================
# BevHub AI — Production Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# =============================================================================

# ── Django Security ──────────────────────────────────────────────────────────
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# False in production, True only for local dev
DJANGO_DEBUG=False

# Comma-separated list — add your Koyeb hostname here
# Example: api-bevhub-yourapp.koyeb.app,localhost
DJANGO_ALLOWED_HOSTS=localhost

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Option 1 — single DATABASE_URL (recommended for Koyeb)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Option 2 — individual vars (legacy, used if DATABASE_URL is not set)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# ── CORS & CSRF (Cloudflare Pages frontend) ───────────────────────────────────
# Comma-separated. Add your Cloudflare Pages URL when known.
# Example: https://bevhub-ai.pages.dev,https://bevhub.ai
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Celery & Redis ───────────────────────────────────────────────────────────
# Leave blank to use background threads (no Redis required)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
BEVHUB_USE_CELERY=False

# ── AI Provider Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
